# Root .gitignore for DustGuard VN Monorepo

# Node & Build artifacts
node_modules/
dist/
.wrangler/
.vercel/

# Firmware PlatformIO & secrets
firmware/.pio/
firmware/**/.pio/
.pio/
firmware/.vscode/
firmware/include/secrets.h

# Environment & Secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
user.env

# Database WAL / Temporary
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal
prisma/*.db-shm
prisma/*.db-wal
dustguard-operations/data/test-*.db
data/test-e2e/
data/test-*/
.playwright-cli/
dustguard-operations/apps/server/uploads/*
!dustguard-operations/apps/server/uploads/.gitkeep
apps/server/uploads/*
!apps/server/uploads/.gitkeep

# Local backup snapshots (generated by scripts/backup-restore.js)
/backups/
uploads/*
artifacts/*
!artifacts/ui-anomalies.json
!artifacts/ui-audit/
!artifacts/ui-audit/**
dustguard-operations/artifacts/*
!dustguard-operations/artifacts/ui-anomalies.json

# CodeLens Graph local index
.codelens/

# Presentation media & Video rendering outputs
presentation/media/
presentation/output/
*.mp4
*.wav

