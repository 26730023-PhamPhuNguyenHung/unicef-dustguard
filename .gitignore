# Root .gitignore for DustGuard VN Monorepo

# Node & Build artifacts
node_modules/
dist/
.wrangler/
.vercel/

# Firmware PlatformIO & secrets
firmware/.pio/
firmware/.vscode/
firmware/include/secrets.h

# Environment & Secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
user.env

# Database WAL / Temporary
*.sqlite-shm
*.sqlite-wal
prisma/*.db-shm
prisma/*.db-wal

# CodeLens Graph local index
.codelens/
