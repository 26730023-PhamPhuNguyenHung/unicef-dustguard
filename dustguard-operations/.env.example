# DustGuard Operations Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=dustguard-operations-dev-secret-key-2026-unicef-civictech
DATABASE_PATH=data/dustguard-operations.db
UPLOAD_DIR=uploads

# Assistive AI Configuration (Optional: NONE | GEMINI | OPENAI)
# If no provider is configured, the system operates seamlessly with local FTS5 and rule-based fallbacks.
AI_PROVIDER=NONE
GEMINI_API_KEY=
OPENAI_API_KEY=

# IoT Ingestion Configuration
IOT_CLOCK_DRIFT_TOLERANCE_MS=300000
IOT_LIVENESS_TIMEOUT_MS=900000

# Cross-Side Integration (Side A <-> Side B webhook auth)
# Shared secret required in the x-service-key header on both
# /api/integrations/community/cases (this side, inbound from Side A) and
# /api/integrations/operations/sync (Side A, inbound from this side).
# CHANGE THIS in any non-local environment -- the value below is a local-dev-only default.
INTEGRATION_SERVICE_KEY=dustguard-internal-2026
# Base URL this server calls back to Side A's sync endpoint.
COMMUNITY_SYNC_URL=http://localhost:3001/api/integrations/operations/sync
